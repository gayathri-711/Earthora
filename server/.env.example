PORT=5000
NODE_ENV=development
# Leave MONGO_URI empty to auto-start an embedded in-memory MongoDB for local development
MONGO_URI=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional external integrations (graceful local fallbacks exist)
STRIPE_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

